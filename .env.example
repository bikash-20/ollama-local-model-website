# ─────────────────────────────────────────────────────────────────────────────
# voice_server.py configuration — copy to `.env` and edit as needed.
#
# The server loads this file automatically on startup (via python-dotenv).
# Anything you leave blank falls back to the defaults in voice_server.py,
# which are tuned for a low-end CPU laptop.
# ─────────────────────────────────────────────────────────────────────────────

# --- Network bindings ---------------------------------------------------------
# Hostnames/IPs the STT and TTS endpoints bind to. Use 127.0.0.1 to only
# accept requests from the same machine (recommended). Set to 0.0.0.0 if
# you want other devices on your LAN (e.g. a phone) to use the voice server.
STT_HOST=127.0.0.1
STT_PORT=5005

TTS_HOST=127.0.0.1
TTS_PORT=5006

# --- Speech-to-text (faster-whisper) -----------------------------------------
# Model size: tiny (~75MB), base (~150MB), small (~500MB), medium (~1.5GB),
# large-v3 (~3GB). base is a good accuracy/speed trade-off on CPU.
WHISPER_MODEL=base

# Compute type: int8 (CPU, smallest), float16 (GPU), float32 (CPU fallback).
WHISPER_COMPUTE=int8

# Beam size for decoding. 1 = greedy (fastest). 5 = better, ~5x slower.
WHISPER_BEAM=1

# --- Text-to-speech (piper) ---------------------------------------------------
# Voice name. Must match the .onnx file in VOICES_DIR below.
# See https://github.com/rhasspy/piper/blob/master/VOICES.md for the full list.
PIPER_VOICE=en_US-amy-medium

# Directory where Piper voice files live. Relative paths are resolved from
# the project root (the folder containing voice_server.py). The setup script
# downloads voices here automatically.
VOICES_DIR=./voices

# Override the download URL for the Piper voice (only used if the file isn't
# already in VOICES_DIR). Default points at the official HuggingFace mirror.
# PIPER_VOICE_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx
# PIPER_VOICE_JSON_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx.json

# --- Ollama origins (used only by start-nocta.sh) ----------------------------
# Comma-separated list of origins Ollama should accept requests from.
# Required when you open Nocta from https://bikash-20.github.io (or any other
# hosted URL) — Ollama rejects requests with an unknown Origin header (HTTP 403).
# file://, http://localhost, and http://127.0.0.1 are always allowed implicitly.
# Examples:
#   OLLAMA_ORIGINS=https://bikash-20.github.io
#   OLLAMA_ORIGINS=https://yourname.github.io,http://192.168.1.20:8000
OLLAMA_ORIGINS=
