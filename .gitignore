# Editor / IDE
.puku/
.puku-cli/
.vscode/
.idea/
.DS_Store

# OS
Thumbs.db

# Node — Playwright smoke tests live under tests/ and need node_modules.
# The app itself stays zero-build; this only exists to run the test suite.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Playwright artifacts (regenerable with `npx playwright install chromium`
# and `npm test`).
/playwright-report/
/test-results/
/blob-report/
.playwright/
# ─────────────────────────────────────────────────────────────────────────────
# Voice server (added for open-source portability)
# ─────────────────────────────────────────────────────────────────────────────

# Downloaded Piper voice models (~60MB each). The setup script fetches these.
voices/
*.onnx
*.onnx.json

# Whisper model cache (~75MB-3GB per model). Set by faster-whisper/HuggingFace.
.cache/
hf_cache/

# Python virtualenvs created by setup.sh
.venv/
venv/
env/

# Local environment configuration (real secrets / overrides). Keep .env.example.
.env

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# start-nocta.sh / stop-nocta.sh runtime artifacts (PIDs and stdout logs).
logs/
